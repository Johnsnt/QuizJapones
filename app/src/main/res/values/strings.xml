    <string name="rdb2p4">を</string>
    <string name="rdb3p4">に</string>
    <string name="rdb4p4">へ</string>
    <!-- Resposta certa: alternativa 3 -->

    <!-- Pergunta 5 -->
    <string name="perg5Texto">5. O que significa a frase: 「危ないですから、あまり遠くへ行かないでください。」?</string>
    <string name="rdb1p5">Por ser perigoso, não vá muito longe, por favor.</string>
    <string name="rdb2p5">Por favor, vá para longe rapidamente.</string>
    <string name="rdb3p5">Como está escuro, não ande devagar.</string>
    <string name="rdb4p5">Não venha para cá, por favor.</string>
    <!-- Resposta certa: alternativa 1 -->

